    {
      "id": "cul-de-sac-residential",
      "revision": 1,
      "term": "cul-de-sac",
      "partsOfSpeech": [
        "noun"
      ],
      "definitionZh": "尽头有圆形回车道的住宅小街",
      "explanationZh": "常见于郊区住宅区，街道没有贯通的出口，车进去后需要掉头返回。",
      "forms": [
        {
          "text": "cul-de-sac",
          "locale": "en-CA",
          "respelling": "KUL-duh-sak",
          "ipa": null,
          "speakText": "cul-de-sac",
          "audio": null
        }
      ],
      "examples": [
        {
          "en": "They live in a quiet cul-de-sac, so kids can play on the street.",
          "zh": "他们住在一条安静的尽头小街，孩子可以在街上玩。",
          "scenarioZh": "聊居住环境"
        }
      ],
      "usageNotesZh": [
        "房产广告常把 cul-de-sac 当作安静、车少的卖点。dead end 泛指不通的路，不一定有回车圈；court 也会出现在这类街道的名称里。"
      ],
      "tags": [
        "housing",
        "driving"
      ],
      "listeningPrompt": "cul-de-sac",
      "homophoneGroup": null,
      "confusableEntryIds": [],
      "addedOn": "2026-10-07",
      "updatedOn": "2026-10-07"
    },
