    {
      "id": "crosswalk-pedestrian",
      "revision": 1,
      "term": "crosswalk",
      "partsOfSpeech": [
        "noun"
      ],
      "definitionZh": "人行横道；斑马线",
      "explanationZh": "行人横过道路的指定区域。",
      "forms": [
        {
          "text": "crosswalk",
          "locale": "en-CA",
          "respelling": "KRAWS-wawk",
          "ipa": null,
          "speakText": "crosswalk",
          "audio": null
        }
      ],
      "examples": [
        {
          "en": "Wait for the light and cross at the crosswalk.",
          "zh": "等信号灯，走人行横道过马路。",
          "scenarioZh": "步行出门"
        }
      ],
      "usageNotesZh": [
        "北美常用 crosswalk，英式英语也会说 zebra crossing。right of way 是“先行权”的说法；实际通行要结合路口信号和当地规则。"
      ],
      "tags": [
        "transit",
        "outdoors"
      ],
      "listeningPrompt": "crosswalk",
      "homophoneGroup": null,
      "confusableEntryIds": [],
