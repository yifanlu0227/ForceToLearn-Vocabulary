      "id": "bumper-to-bumper-traffic",
      "revision": 1,
      "term": "bumper-to-bumper",
      "partsOfSpeech": [
        "adjective",
        "adverb"
      ],
      "definitionZh": "车贴车的严重堵车",
      "explanationZh": "形容车流十分拥堵，车之间几乎没有空隙。",
      "forms": [
        {
          "text": "bumper-to-bumper",
          "locale": "en-CA",
          "respelling": "BUHM-per-tuh-BUHM-per",
          "ipa": null,
          "speakText": "bumper-to-bumper",
          "audio": null
        }
      ],
      "examples": [
        {
          "en": "Traffic was bumper-to-bumper the whole way home.",
          "zh": "一路回家全程堵得车贴车。",
          "scenarioZh": "描述交通"
        }
      ],
      "usageNotesZh": [
        "常与 traffic 连用，比 traffic jam 更形象。bumper 就是汽车保险杠。"
      ],
      "tags": [
        "driving",
        "transit"
      ],
      "listeningPrompt": "bumper-to-bumper",
      "homophoneGroup": null,
