    {
      "id": "carsick-motion",
      "revision": 1,
      "term": "carsick",
      "partsOfSpeech": [
        "adjective"
      ],
      "definitionZh": "晕车的",
      "explanationZh": "坐车时头晕、恶心或想吐。",
      "forms": [
