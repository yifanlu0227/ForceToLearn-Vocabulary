          "ipa": null,
          "speakText": "carsick",
          "audio": null
        }
      ],
      "examples": [
        {
          "en": "I get carsick if I read in the car.",
          "zh": "我在车里看书就会晕车。",
          "scenarioZh": "出行聊天"
        }
      ],
      "usageNotesZh": [
        "seasick 是晕船，airsick 是晕机，统称 motion sickness。"
      ],
      "tags": [
        "transit",
        "daily-life"
      ],
      "listeningPrompt": "carsick",
