{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Force to Learn explicit corrections v1/v2/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "correctionId",
    "publishedOn",
    "changes"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "correctionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,79}$"
    },
    "publishedOn": {
      "type": "string",
      "format": "date"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "id",
              "expectedRevision",
              "entry"
            ],
            "properties": {
              "action": {
                "const": "update"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{2,79}$"
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 1
              },
              "entry": {
                "$ref": "#/$defs/entry"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "id",
              "expectedRevision"
            ],
            "properties": {
              "action": {
                "enum": [
                  "archive",
                  "restore"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{2,79}$"
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "id",
              "expectedRevision",
              "wordAnalysis"
            ],
            "properties": {
              "action": {
                "const": "analyze"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{2,79}$"
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 1
              },
              "wordAnalysis": {
                "$ref": "#/$defs/wordAnalysis"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "term",
        "partsOfSpeech",
        "definitionZh",
        "explanationZh",
        "examples",
        "usageNotesZh",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,79}$"
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "partsOfSpeech": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "noun",
              "verb",
              "adjective",
              "adverb",
              "phrasal_verb",
              "phrase",
              "preposition",
              "interjection"
            ]
          }
        },
        "definitionZh": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 160
        },
        "explanationZh": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 3000
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "usageNotesZh": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 3000
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "wordAnalysis": {
          "$ref": "#/$defs/wordAnalysis"
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh",
        "scenarioZh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "zh": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scenarioZh": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "wordAnalysis": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyWordAnalysis"
        },
        {
          "$ref": "#/$defs/conciseWordAnalysis"
        }
      ]
    },
    "legacyWordAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseFormZh",
        "rootsZh",
        "affixesZh",
        "mnemonicZh"
      ],
      "properties": {
        "baseFormZh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "rootsZh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "affixesZh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "mnemonicZh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        }
      }
    },
    "conciseWordAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textZh"
      ],
      "properties": {
        "textZh": {
          "type": "string",
          "maxLength": 180,
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
            }
          ],
          "not": {
            "pattern": "构词与记忆|AI\\s*辅助整理|(?:原形|词根|词缀|记忆方法)[：:]|[\\r\\n]"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "changes": {
            "items": {
              "properties": {
                "wordAnalysis": {
                  "$ref": "#/$defs/legacyWordAnalysis"
                },
                "entry": {
                  "properties": {
                    "wordAnalysis": {
                      "$ref": "#/$defs/legacyWordAnalysis"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "changes": {
            "items": {
              "properties": {
                "wordAnalysis": {
                  "$ref": "#/$defs/legacyWordAnalysis"
                },
                "entry": {
                  "properties": {
                    "wordAnalysis": {
                      "$ref": "#/$defs/legacyWordAnalysis"
                    }
                  },
                  "required": [
                    "wordAnalysis"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "changes": {
            "items": {
              "properties": {
                "wordAnalysis": {
                  "$ref": "#/$defs/conciseWordAnalysis"
                },
                "entry": {
                  "properties": {
                    "wordAnalysis": {
                      "$ref": "#/$defs/conciseWordAnalysis"
                    }
                  },
                  "required": [
                    "wordAnalysis"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
