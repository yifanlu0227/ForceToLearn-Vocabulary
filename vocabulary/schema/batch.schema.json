{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Force to Learn fixed-field addition batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "title",
    "publishedOn",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "batchId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000,
      "pattern": "\\S"
    },
    "publishedOn": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "term",
        "partsOfSpeech",
        "definitionZh",
        "explanationZh",
        "examples",
        "usageNotesZh",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,79}$"
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "partsOfSpeech": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "noun",
              "verb",
              "adjective",
              "adverb",
              "phrasal_verb",
              "phrase",
              "preposition",
              "interjection"
            ]
          }
        },
        "definitionZh": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 160
        },
        "explanationZh": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 3000
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "usageNotesZh": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 3000
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh",
        "scenarioZh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "zh": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scenarioZh": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
